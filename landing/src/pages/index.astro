---
import Base from "../layouts/Base.astro";
import Builders from "../components/Builders.astro";
import Closing from "../components/Closing.astro";
import Ecosystem from "../components/Ecosystem.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Protocol from "../components/Protocol.astro";
import ReadGuide from "../components/ReadGuide.astro";
import snapshot from "../data/snapshot.json";
import { fetchLandingData } from "../lib/landing-data.mjs";
import type { LandingData } from "../lib/types";

// Live data at build time. When an API is down the page still ships, with the last committed
// snapshot and the date it was taken. LANDING_DATA=snapshot skips the network in local work.
let data: LandingData = snapshot as LandingData;
if (import.meta.env.LANDING_DATA !== "snapshot") {
  try {
    data = await fetchLandingData();
  } catch (error) {
    console.warn(`Landing data: using the committed snapshot (${(error as Error).message})`);
  }
}
---

<Base
  title="Seer: markets built to answer questions"
  description="Seer is the information finance protocol under Deep, Futarchy, Opportunity Markets and Risk Pricing. Ask a question, and the market's prices become a live estimate anyone can read."
>
  <Header />
  <main id="main">
    <Hero data={data} />
    <ReadGuide data={data} />
    <Ecosystem data={data} />
    <Protocol />
    <Builders />
    <Closing />
  </main>
  <Footer />
</Base>
