<section class="closing field-ink" data-theme="dark" aria-labelledby="closing-title">
  <div class="container closing-inner">
    <div class="closing-copy">
      <h2 id="closing-title" class="h2">Have a question worth pricing?</h2>
      <div class="closing-actions">
        <a class="seer-button seer-button-primary seer-button-lg" href="https://app.seer.pm/create-market">Create a market</a>
        <a class="seer-button seer-button-secondary seer-button-lg" href="https://app.seer.pm">Explore markets</a>
      </div>
    </div>
    <span class="closing-wordmark seer-brand-wordmark" role="img" aria-label="Seer"></span>
  </div>
</section>

<style>
  .closing {
    padding-top: var(--section-block);
    overflow: hidden;
  }
  .closing-inner {
    display: grid;
    gap: clamp(48px, 8vw, 120px);
  }
  .closing h2 {
    max-width: 14ch;
    color: var(--seer-brand-lavender);
  }
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  /* The poster close: the wordmark at full measure in lavender, cropped by the footer's edge. */
  .closing-wordmark {
    width: 100%;
    height: auto;
    aspect-ratio: 600 / 190;
    color: var(--seer-brand-lavender);
    margin-bottom: -3%;
  }
</style>
