---
import { seerApps } from "@seer-pm/ui-kit";
---

<header class="site-header field-ink" data-theme="dark">
  <div class="container header-row">
    <a href="/" class="home-link" aria-label="Seer home">
      <span class="seer-brand-lockup" aria-hidden="true">
        <span class="seer-brand-bird"></span>
        <span class="seer-brand-wordmark"></span>
      </span>
    </a>
    <nav aria-label="Main" class="main-nav">
      <details class="apps-menu" data-menu>
        <summary>
          Apps
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
        </summary>
        <div class="apps-panel" data-theme="light">
          <ul>
            {
              seerApps.map((app) => (
                <li>
                  <a href={app.url}>
                    <span class="app-name">{app.name}</span>
                    <span class="app-summary">{app.summary}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="panel-extra">
            <li><a href="https://docs.seer.pm">Docs</a></li>
            <li><a href="https://seer-pm.medium.com">Blog</a></li>
          </ul>
        </div>
      </details>
      <a class="nav-link" href="https://docs.seer.pm">Docs</a>
      <a class="nav-link" href="https://seer-pm.medium.com">Blog</a>
    </nav>
    <a class="seer-button seer-button-primary open-app" href="https://app.seer.pm">Open app</a>
  </div>
</header>

<script is:inline>
  // <details> opens and closes without JS; this only adds outside-click and Escape dismissal.
  document.addEventListener("click", function (event) {
    document.querySelectorAll("details[data-menu][open]").forEach(function (menu) {
      if (!menu.contains(event.target)) menu.removeAttribute("open");
    });
  });
  document.addEventListener("keydown", function (event) {
    if (event.key !== "Escape") return;
    document.querySelectorAll("details[data-menu][open]").forEach(function (menu) {
      menu.removeAttribute("open");
      menu.querySelector("summary").focus();
    });
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 5;
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 80px;
  }
  .home-link {
    color: var(--seer-on-ink);
    flex: none;
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-right: auto;
    font-size: 15px;
  }
  .nav-link,
  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: var(--seer-radius-sm);
    color: var(--seer-on-ink-muted);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--seer-duration-fast) var(--seer-ease-out);
  }
  .nav-link:hover,
  summary:hover,
  .apps-menu[open] summary {
    color: var(--seer-on-ink);
  }
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--seer-duration-fast) var(--seer-ease-out);
  }
  .apps-menu[open] summary svg {
    transform: rotate(180deg);
  }
  .apps-menu {
    position: relative;
  }
  .apps-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: min(420px, calc(100vw - 2 * var(--gutter)));
    padding: 8px;
    border-radius: var(--seer-radius-md);
    background: var(--seer-surface);
    color: var(--seer-text);
    box-shadow: 0 18px 40px -12px rgb(8 6 20 / 0.55);
    animation: panel-in 180ms var(--seer-ease-out);
  }
  .apps-panel ul {
    list-style: none;
    padding: 0;
  }
  .apps-panel a {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border-radius: var(--seer-radius-sm);
    text-decoration: none;
  }
  .apps-panel a:hover {
    background: var(--seer-surface-raised);
  }
  .app-name {
    font-weight: 600;
  }
  .app-summary {
    color: var(--seer-muted);
    font-size: 14px;
    line-height: 1.45;
  }
  .panel-extra {
    display: none;
    margin-top: 4px;
    padding-top: 4px !important;
    border-top: 1px solid var(--seer-border);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (max-width: 640px) {
    .header-row {
      gap: 12px;
      min-height: 68px;
    }
    .main-nav {
      order: 2;
      margin-right: 0;
    }
    .home-link {
      margin-right: auto;
    }
    .open-app {
      order: 3;
    }
    .nav-link {
      display: none;
    }
    .panel-extra {
      display: block;
    }
    .apps-panel {
      position: fixed;
      top: 68px;
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
    }
  }
</style>
