---
import type { LandingData } from "../lib/types";
import { chainName, day, shortAddress, usd } from "../lib/format.mjs";
import BeliefHills from "./BeliefHills.astro";
import SnapshotControl from "./SnapshotControl.astro";

interface Props {
  data: LandingData;
}

const { data } = Astro.props;
const { hero } = data;
const explorer = {
  1: "https://etherscan.io",
  10: "https://optimistic.etherscan.io",
  100: "https://gnosisscan.io",
  8453: "https://basescan.org",
}[hero.chainId];
const shown = hero.snapshots.filter((snapshot) => snapshot.probabilities.some((value) => value !== null));
---

<section class="hero field-ink hills-scope" data-theme="dark" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <h1 id="hero-title">Markets built to answer questions.</h1>
    <p class="lead hero-lead">
      Seer is the information finance protocol under Deep, Futarchy, Opportunity Markets and Risk Pricing. Ask a
      question, and the market's prices become a live estimate anyone can read.
    </p>
    <div class="hero-actions">
      <a class="seer-button seer-button-primary" href="https://app.seer.pm">Explore markets</a>
      <a class="seer-button seer-button-secondary" href="#read">How to read a market</a>
    </div>

    <div class="hero-question">
      <p class="question"><a href={hero.url}>{hero.question}</a></p>
      <p class="question-meta">
        {
          hero.asker ? (
            <>
              Asked by <strong>{hero.asker}</strong>. {hero.use}
            </>
          ) : (
            <>
              Asked on Seer by{" "}
              {explorer ? (
                <a href={`${explorer}/address/${hero.creator}`}>{shortAddress(hero.creator)}</a>
              ) : (
                shortAddress(hero.creator)
              )}{" "}
              on {chainName(hero.chainId)}, with {usd(hero.liquidityUSD)} in liquidity.
            </>
          )
        }
      </p>
      <a class="text-link question-link" href={hero.url}>
        Open this market
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6"></path></svg>
      </a>
      <div class="question-control">
        <SnapshotControl id="hero" labels={shown.map((snapshot) => snapshot.label)} />
      </div>
    </div>

    <div class="hero-chart">
      <BeliefHills
        outcomes={hero.outcomes}
        snapshots={hero.snapshots}
        caption={`How the market's probabilities for "${hero.question}" moved over the last 90 days.`}
      />
      <p class="hero-stamp numeric">
        Prices as of {day(data.generatedAt)}. Each hill is one answer; its height is the chance the market gives it.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(24px, 3.5vw, 48px) clamp(40px, 6vw, 72px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    grid-template-areas:
      "title question"
      "lead question"
      "actions question"
      "chart chart";
    column-gap: clamp(32px, 6vw, 96px);
  }
  h1 {
    grid-area: title;
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.1rem + 3.7vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--seer-brand-lavender);
  }
  .hero-lead {
    grid-area: lead;
    max-width: 56ch;
    margin-top: 20px;
    color: var(--seer-on-ink-muted);
  }
  .hero-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero-actions .seer-button {
    min-height: 48px;
    padding-inline: 22px;
    font-size: 15px;
  }
  .hero-question {
    grid-area: question;
    align-self: end;
    padding-top: 24px;
    border-top: 1px solid var(--seer-ink-border);
  }
  .question {
    font-size: clamp(1.125rem, 1rem + 0.7vw, 1.625rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--seer-on-ink);
  }
  .question a {
    text-decoration: none;
  }
  .question a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .question-meta {
    margin-top: 12px;
    font-size: 14px;
    color: var(--seer-on-ink-muted);
  }
  .question-meta strong {
    color: var(--seer-on-ink);
  }
  .question-meta a {
    font-variant-numeric: tabular-nums;
    text-underline-offset: 3px;
  }
  .question-link {
    margin-top: 16px;
    color: var(--seer-brand-lavender);
  }
  .question-link svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .question-control {
    margin-top: 28px;
  }
  .hero-chart {
    grid-area: chart;
    margin-top: clamp(24px, 3vw, 40px);
  }
  .hero-stamp {
    margin-top: 24px;
    font-size: 13px;
    color: var(--seer-on-ink-muted);
  }

  /* Stacked, the whole first screen still carries the offer, the action and the live
     distribution: the lead steps down a size and the question itself is the link to its market. */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "title"
        "lead"
        "actions"
        "question"
        "chart";
    }
    .hero-lead {
      margin-top: 14px;
      font-size: 1rem;
    }
    .hero-actions {
      margin-top: 20px;
    }
    .hero-actions .seer-button {
      min-height: 44px;
      padding-inline: 16px;
      font-size: 14px;
    }
    .hero-question {
      margin-top: 24px;
      padding-top: 18px;
    }
    .question-meta {
      margin-top: 6px;
      font-size: 13px;
    }
    .question-link {
      display: none;
    }
    .question-control {
      margin-top: 14px;
    }
    .hero-chart {
      margin-top: 12px;
    }
  }
</style>
